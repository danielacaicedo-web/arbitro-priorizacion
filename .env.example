# Copiar a .env.local para desarrollo (Vercel) — nunca commitear el archivo real.

# OpenRouter — evaluación de iniciativas con IA
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2

# Firebase — config pública del cliente (no son secretos, pero se centralizan aquí)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
